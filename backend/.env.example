# SukaSeafood backend — copy to .env and adjust.
# .env is gitignored; never commit real credentials.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=["*"]

# ---------------------------------------------------------------------------
# PostgreSQL — the system of record
# ---------------------------------------------------------------------------
# Local Docker (docker compose up -d db):
DATABASE_URL=postgresql+asyncpg://sukaseafood:sukaseafood@localhost:5433/sukaseafood

# Supabase (Project Settings -> Database -> Connection string -> URI).
# Use the SESSION POOLER host for a long-running API; the transaction pooler
# does not support prepared statements, which asyncpg relies on.
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Consumed by docker-compose.yml
POSTGRES_USER=sukaseafood
POSTGRES_PASSWORD=sukaseafood
POSTGRES_DB=sukaseafood
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Firebase — hosting and object storage only, never domain data
# ---------------------------------------------------------------------------
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=sukaseafood
FIREBASE_STORAGE_BUCKET=sukaseafood.firebasestorage.app
FIREBASE_IMAGE_PREFIX=seafood

# Only needed for signed URLs or uploads. On Cloud Run leave this empty and let
# Application Default Credentials handle it.
# FIREBASE_CREDENTIALS_PATH=./service-account.json

# ---------------------------------------------------------------------------
# CV
# ---------------------------------------------------------------------------
IDENTIFY_MODEL_VERSION=mock-cv-v0.1
