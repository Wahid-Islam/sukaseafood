# SukaSeafood backend — copy to .env and adjust.
# .env is gitignored; never commit real credentials.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=["*"]

# ---------------------------------------------------------------------------
# PostgreSQL — the system of record
# ---------------------------------------------------------------------------
# Local Docker (docker compose up -d db):
DATABASE_URL=postgresql+asyncpg://sukaseafood:sukaseafood@localhost:5433/sukaseafood

# Firebase Cloud SQL (project sukaseafood-654b7), reached through the Cloud SQL
# Auth Proxy. Start the proxy first — see backend/README.md — then point the URL
# at its local listener. With --auto-iam-authn the proxy supplies the IAM login
# token as the password, so the value below is ignored and there is no static
# database password to leak. Percent-encode the @ in the IAM username.
# DATABASE_URL=postgresql+asyncpg://you%40gmail.com:unused@127.0.0.1:5432/sukaseafood-654b7-database

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Consumed by docker-compose.yml
POSTGRES_USER=sukaseafood
POSTGRES_PASSWORD=sukaseafood
POSTGRES_DB=sukaseafood
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Firebase — hosting and object storage only, never domain or user data
# ---------------------------------------------------------------------------
FIREBASE_ENABLED=true
FIREBASE_PROJECT_ID=sukaseafood-654b7
FIREBASE_STORAGE_BUCKET=sukaseafood-654b7.firebasestorage.app
FIREBASE_IMAGE_PREFIX=seafood

# Only needed for signed URLs or uploads. On Cloud Run leave this empty and let
# Application Default Credentials handle it.
# FIREBASE_CREDENTIALS_PATH=./service-account.json

# ---------------------------------------------------------------------------
# Auth — PostgreSQL app_user + JWT (no Firestore)
# ---------------------------------------------------------------------------
JWT_SECRET=dev-only-change-me-sukaseafood
JWT_EXPIRE_MINUTES=20160

# ---------------------------------------------------------------------------
# OpenAI — Epic 4 recipe generation (server-side only; never ship to Flutter)
# ---------------------------------------------------------------------------
# Leave empty to disable recipes (POST /recipes/generate returns 503).
# On Cloud Run store it in Secret Manager:
#   gcloud run services update sukaseafood-api --update-secrets=OPENAI_API_KEY=openai-api-key:latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# CV
# ---------------------------------------------------------------------------
# Optional. Cloud Run sets this at deploy so /health names the build.
# GIT_SHA=
