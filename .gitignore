# Root .gitignore — monorepo

# Secrets / env
.env
.env.*
!.env.example
frontend/carto_basemaps.key
*.pem
*.p12
credentials*.json
service-account*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/
backend/*.db
backend/**/*.db

# Flutter / Dart
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/build/
frontend/.pub-cache/
frontend/ios/Pods/
frontend/ios/.symlinks/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/debug/
frontend/android/app/profile/
frontend/android/app/release/
frontend/**/*.iml
frontend/.idea/

# Local zip extract of catalogue photos; committed copies live in assets/
frontend/Images/

# Large raw OpenDOSM monthly extracts (fetch via data/README.md)
data/open_dosm/*.csv
data/open_dosm/*.parquet
data/open_dosm/**/*.csv
data/open_dosm/**/*.parquet

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
.runtimeconfig.json

# Postgres
backend/db/dump/*.sql

# Cloud SQL Auth Proxy binary — a ~30 MB Google-signed release, fetched per
# machine rather than vendored. See docs/architecture/firebase-cloud-sql.md.
tools/cloud-sql-proxy*

# Leftover / local
mobile/
_pdf_preview/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Large local product artefacts (keep on disk / SharePoint; not in git)
docs/artefacts/*.pdf

# Local UI PDF raster previews
_ui_preview/

# --- CV scanner ---------------------------------------------------------------
# What is committed and what is not, and why:
#
#   cv/handoff/          COMMITTED. The frozen model artifact (~6 MB) plus its
#                        class map and model card. This is the source of truth
#                        the backend serves; a clone without it cannot scan, and
#                        the class map must stay byte-identical to the .onnx it
#                        was exported with.
#   cv/data/manifest.csv COMMITTED. The provenance record — which image, which
#                        licence, which split. Small, and it is what makes the
#                        accuracy figure reproducible.
#
# Everything below is regenerable, large, or both.

# Training checkpoints — 6 MB each, and the ONNX export in handoff/ is what
# actually gets served. Re-create with scripts/train.py.
cv/artifacts/*.pt
cv/sukaseafood_cv_handoff/training_checkpoint.pt

# ImageNet initialisation weights (~52 MB). Re-fetch with:
#   python scripts/fetch_weights.py
cv/weights/

# The image corpus itself — hundreds of MB to ~2 GB. Kept outside the repo;
# rebuild the manifest with scripts/import_candidates.py.
cv/data/images/
cv/incoming/

# A deploy-time copy of cv/handoff/. Committing it would put the same 6 MB
# artifact in the repository twice and let the two drift apart. run.sh installs
# it automatically when it is missing.
backend/cv_package/

# Epic 4: AI recipe photos cached on local disk
backend/generated/
