# Settings for docker-compose.yml. Copy to .env and adjust:
#
#     cp .env.example .env
#
# Compose reads .env from this directory automatically, so once it exists you
# can just run `docker compose up -d db` with no inline variables.
#
# This file configures the CONTAINER. The backend application is configured
# separately in backend/.env — if you change POSTGRES_PORT here, change the port
# in backend/.env DATABASE_URL to match.

# Host port the database is published on. Change this if something already
# listens on 5432 — a system Postgres, Postgres.app, or another project.
# Check with:  sudo lsof -nP -iTCP:5432 -sTCP:LISTEN
POSTGRES_PORT=5432

POSTGRES_USER=sukaseafood
POSTGRES_PASSWORD=sukaseafood
POSTGRES_DB=sukaseafood

# pgAdmin, started with:  docker compose --profile tools up -d pgadmin
# The email domain must be a real, non-reserved TLD — pgAdmin rejects .local,
# .test and .localhost and crash-loops at startup if you use one.
PGADMIN_EMAIL=dev@sukaseafood.com
PGADMIN_PASSWORD=sukaseafood
PGADMIN_PORT=5050
